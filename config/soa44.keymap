#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Layer definitions

#define DEFAULT_L		0
#define WINDOWS_L		1
#define MAC_L			2
#define IOS_L			3
#define LINUX_L			4
#define LEFT_L	 		5
#define RIGHT_L			6
#define CONFIG_L		7
#define TRACKBALL_L		8
#define TRACKBALL_L2	9
#define SCROLL_L		10
#define CENTER_L		11
#define CENTER2_L		12
#define EXT1_L			13
#define BT_L			14

// ZMK Layout Shift モジュール(https://github.com/kot149/zmk-layout-shift/blob/v1/README_ja.md)を使う
// &kpをオーバーライド
#include <layout_shift_kp_override.dtsi>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <6 7>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <7 8>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <18 19>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <19 20>;
        };

        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <20 21>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <30 31>;
        };

        dot {
            bindings = <&kp DOT>;
            key-positions = <31 32>;
        };

        asterisk {
            bindings = <&kp ASTERISK>;
            key-positions = <17 18>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <29 30>;
        };

        mb3 {
            bindings = <&mkp MCLK>;
            key-positions = <6 8 7>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
/*
        // Disconnect from all once for reliable connection to selected profile.
        // ZMK automatically reconnects to current profile right after disconnection.

        out_bt_nxt: out_bt_nxt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_NXT &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4>;
        };

        // Select specific BT device (0-4) and disconnect others

        out_bt_0: out_bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4>;
        };

        out_bt_1: out_bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 1 &bt BT_DISC 0 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4>;
        };

        out_bt_2: out_bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 2 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 3 &bt BT_DISC 4>;
        };

        out_bt_3: out_bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 3 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 4>;
        };

        out_bt_4: out_bt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            bindings = <&out OUT_BLE &bt BT_SEL 4 &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3>;
        };

        // Change default layer for current profile to next layer

        dfnxt: dfnxt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&df DF_INC &animtrig ANM_TRG 2>;
        };
*/
    };

    behaviors {
        // for ZMK Layout Shiftモジュール-S
        // KeymapEditor対策で&kpを定義しておく
        // Keep the original key_press behavior for ZMK core components
        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // Override the existing &kp behavior to use our custom implementation
        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };
        // for ZMK Layout Shiftモジュール-ENTER

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp ESCAPE      &kp Q         &kp W         &kp E             &kp R        &kp T                  &kp Y            &kp U        &kp I  &kp O      &kp P         &kp BACKSPACE
&mt LCTRL TAB   &kp A         &kp S         &kp D             &kp F        &kp G                  &kp H            &kp J        &kp K  &kp L      &lt 5 MINUS   &kp EQUAL
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C             &kp V        &kp B                  &kp SQT          &kp N        &mkp LCLK         &mkp RCLK     &kp SLASH
                &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 INT_HENKAN  &lt 4 SPACE  &lt 3 INT_MUHENKAN     &kp BACKSPACE    &kp ENTER                      &kp QUESTION
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &mkp MB4  &mkp MB3   &mkp MB5   &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans    &mkp LCLK  &mkp RCLK  &mo 5      &mo 5
&trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans    &trans     &mkp LCLK  &mkp RCLK  &trans
        &trans  &trans  &trans  &trans  &trans       &trans  &trans                          &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp EXCL  &kp EXCLAMATION     &kp DQT        &kp HASH         &kp DOLLAR     &kp PERCENT      &kp AMPS         &kp SQT        &kp LPAREN       &kp RPAREN       &kp PIPE          &kp RBKT
&trans    &kp LCTRL           &kp SEMICOLON  &kp COLON        &kp LBRACE     &kp RBRACE       &kp CARET         &kp AT         &kp LBRACKET     &kp RBRACKET     &kp EQUAL         &kp BACKSLASH
&trans    &mt LEFT_SHIFT TAB  &kp PLUS       &kp ASTERISK     &kp TILDE      &kp PRINTSCREEN  &kp PLUS          &kp SEMICOLON  &kp COLON        &kp LESS_THAN    &kp GREATER_THAN  &kp TILDE
          &trans              &trans         &trans           &trans         &trans           &kp LCTRL         &kp ENTER                                        &trans
            >;
        };

        NUM {
            bindings = <
&kp NUMBER_1  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5            &kp NUMBER_6      &kp NUMBER_7  &kp NUMBER_8     &kp NUMBER_9  &kp NUMBER_0       &kp N0
&trans        &none         &kp F2        &kp F3        &kp F4        &kp F5                  &kp F6            &kp F7        &kp F8           &kp F9        &kp UNDERSCORE     &trans
&trans        &trans        &trans        &trans        &trans        &trans                  &kp BACKQUOTE     &kp PLUS      &kp ASTERISK     &kp COMMA     &kp PERIOD         &kp SLASH
              &trans        &trans        &trans        &trans        &trans                  &trans            &trans                                       &trans
            >;
        };

        ARROW {
            bindings = <
&trans          &kp TAB    &kp LEFT_ALT  &kp END    &lt 6    SPACE    &kp PRINTSCREEN         &kp LC(Y)      &mkp MB4        &mkp MB3  &mkp MB5   &kp UP_ARROW  &kp PAGE_UP
&trans          &kp HOME   &kp LC(S)     &kp DEL    &kp RIGHT_ARROW   &kp LEFT_SHIFT          &kp BACKSPACE  &none           &none     &mkp LCLK  &mkp RCLK     &kp PAGE_DOWN
&kp LEFT_SHIFT  &kp LC(Z)  &kp LC(X)     &kp LC(C)  &kp LC(V)         &kp LEFT_ARROW          &kp PAGE_DOWN  &kp DOWN_ARROW  &trans    &mkp LCLK  &mkp RCLK     &kp ENTER
                &trans     &trans        &trans     &trans            &trans                  &kp RCTRL      &trans                               &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans                  &trans
            >;
        };

// &trans  &trans        &trans        &trans        &trans  &trans  &out_bt_0     &out_bt_1     &out_bt_2     &out_bt_3     &out_bt_4       &trans
        Bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans
&trans  &trans        &trans        &trans        &trans  &trans  &trans        &trans        &trans        &trans        &trans          &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans  &bootloader   &trans        &trans        &trans        &trans          &bt BT_CLR
        &trans        &trans        &trans        &trans  &trans  &trans        &trans                                    &bt BT_CLR_ALL
            >;
        };
    };
};
